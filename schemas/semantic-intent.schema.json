{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9_.-]{0,98}[A-Za-z0-9_-])?$"
          },
          "context": {
            "type": "string",
            "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9_.-]{0,98}[A-Za-z0-9_-])?$"
          },
          "key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "slot": {
            "type": "string",
            "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9_.-]{0,98}[A-Za-z0-9_-])?$"
          }
        },
        "required": [
          "action",
          "context",
          "key"
        ],
        "additionalProperties": false
      },
      "maxItems": 512,
      "minItems": 1
    }
  },
  "required": [
    "changes"
  ],
  "additionalProperties": false
}
