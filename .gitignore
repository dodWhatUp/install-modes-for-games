# This working folder also contains several GB of private experiment backups,
# downloaded tools, drivers, game files and logs. Publish only the curated
# source/documentation paths explicitly allowed below.
*

!.gitignore
!.gitattributes
!README.md
!CONTRIBUTING.md
!AGENTS.md

!docs/
!docs/**
!games/
!games/**
!examples/
!examples/**
!scripts/
!scripts/**
!templates/
!templates/**
!evidence/
!evidence/**
!preferences/
!preferences/**

# Versioned schemas are source contracts, not generated runtime data.
!schemas/
!schemas/*.schema.json

# Only the reviewed data-only pack shapes are publishable. Keep arbitrary
# files under game-packs ignored unless a later review adds another exact
# source role and pattern.
!game-packs/
!game-packs/format-examples/
!game-packs/format-examples/*/
!game-packs/format-examples/*/pack.json
!game-packs/format-examples/*/fixtures/
!game-packs/format-examples/*/fixtures/*.cfg
!game-packs/format-examples/*/fixtures/*.ini
!game-packs/format-examples/*/fixtures/*.json
!game-packs/format-examples/*/fixtures/*.jsonc
!game-packs/format-examples/*/fixtures/*.txt
!game-packs/format-examples/*/fixtures/*.vdf
!game-packs/format-examples/*/fixtures/*.xml
!game-packs/research-drafts/
!game-packs/research-drafts/*/
!game-packs/research-drafts/*/AUTHORING.md
!game-packs/research-drafts/*/location-evidence.json
!game-packs/research-drafts/*/pack.json

# Sanitized input-device records only; private exports remain outside Git.
!devices/
!devices/master-forge-left/
!devices/master-forge-left/*.md
!devices/master-forge-left/*.json

# Never publish generated or third-party binaries, even if placed in an
# allowed directory by mistake.
*.7z
*.dll
*.exe
*.pdb
*.zip
*.bak
*.dmp

# Preserved authored source candidates; never cache or native personal exports.
!source-snapshots/
!source-snapshots/**
__pycache__/
*.pyc
*.zip.new*
games/path-of-exile-2/azeron-profile-pair/import-folder/
games/path-of-exile-2/grouped-r2/native-profiles/
