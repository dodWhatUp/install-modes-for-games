+++ b/OptiScaler/dlssnr/NativeSrControl.h
@@ -0,0 +1,62 @@
+#pragma once
+#include <Windows.h>
+#include <filesystem>
+#include <fstream>
+#include <ctime>
+#include <string>
+
+namespace DlssNr
+{
+// Narrow request channel to the already installed Cyberpunk CET adapter.
+// The adapter owns all native settings access. No renderer ratios are fabricated here.
+inline void RenderNativeSrControl()
+{
+    static const std::filesystem::path adapter = []() -> std::filesystem::path {
+        wchar_t exe[32768] = {};
+        const auto length = GetModuleFileNameW(nullptr, exe, 32768);
+        if (!length || length >= 32768) return {};
+        const std::filesystem::path path(exe);
+        if (_wcsicmp(path.filename().c_str(), L"Cyberpunk2077.exe") != 0) return {};
+        return path.parent_path() / L"plugins/cyber_engine_tweaks/mods/GraphicsHotkeys";
+    }();
+    ImGui::Separator();
+    ImGui::TextUnformatted("DLSS Super Resolution");
+    if (adapter.empty())
+    {
+        ImGui::TextDisabled("Live SR shortcut unavailable for this game.");
+        return;
+    }
+    static ULONGLONG lastPoll = 0, lastRequest = 0;
+    static std::time_t statusTime = 0;
+    static std::string mode;
+    const auto now = GetTickCount64();
+    if (lastPoll == 0 || now - lastPoll >= 500)
+    {
+        lastPoll = now;
+        statusTime = 0;
+        mode.clear();
+        std::ifstream status(adapter / L"sr-status.txt");
+        long long stamp = 0;
+        char separator = 0;
+        if (status >> stamp >> separator && separator == '|')
+        {
+            std::getline(status, mode);
+            if (mode.size() <= 64) statusTime = static_cast<std::time_t>(stamp);
+        }
+    }
+    const auto age = std::time(nullptr) - statusTime;
+    const bool fresh = statusTime > 0 && age >= 0 && age <= 3;
+    const bool ready = fresh && (mode == "Auto" || mode == "DLAA" || mode == "Quality" ||
+                                 mode == "Balanced" || mode == "Performance" || mode == "UltraPerformance");
+    ImGui::Text("Native mode: %s", fresh ? mode.c_str() : "adapter waiting");
+    ImGui::BeginDisabled(!ready || (lastRequest != 0 && now - lastRequest < 2000));
+    if (ImGui::Button("Cycle DLSS quality (F6)"))
+    {
+        std::ofstream request(adapter / L"sr-request.txt", std::ios::trunc);
+        if (request) request << "cycle|" << std::time(nullptr) << '\n';
+        lastRequest = now;
+    }
+    ImGui::EndDisabled();
+    ImGui::TextDisabled("DLAA > Quality > Balanced > Performance");
+}
+}
