+void RenderCompactMenu(Config* config, float menuResScale)
+{
+    ImGui::PushItemWidth(170.0f * menuResScale);
+
+    bool enabled = config->DlssNrEnabled.value_or_default();
+    if (ImGui::Checkbox("Enabled", &enabled))
+        config->DlssNrEnabled = enabled;
+    HelpMarker("F10 toggles Neural Rendering without opening a menu.");
+
+    static const char* presetNames[] = { "Preset 0", "Preset 1", "Preset 2", "Preset 3" };
+    int preset = std::clamp((int) config->DlssNrPreset.value_or_default(), 0, 3);
+    if (ImGui::Combo("Model preset", &preset, presetNames, IM_ARRAYSIZE(presetNames)))
+        config->DlssNrPreset = (uint32_t) preset;
+    HelpMarker("The NVIDIA model exposes four numeric presets, but their visual meanings are undocumented. F11 cycles them.");
+
+    static const char* styleNames[] = { "Standard", "Natural", "Cinematic" };
+    int style = std::clamp((int) config->DlssNrStyle.value_or_default(), 0, 2);
+    if (ImGui::Combo("Style", &style, styleNames, IM_ARRAYSIZE(styleNames)))
+        config->DlssNrStyle = (uint32_t) style;
+
+    DeferredSlider("Intensity", &config->DlssNrIntensity, 0.0f, 2.0f, 1.0f);
+
+    DeferredSlider("Working scale", &config->DlssNrWorkingScale, 0.25f, 1.0f, 1.0f, "%.2fx");
+    HelpMarker("Fraction of the active image processed by the model. 1.00 is full working resolution.");
+
+    int passes = std::clamp((int) config->DlssNrPasses.value_or_default(), 1, 3);
+    if (ImGui::SliderInt("Passes", &passes, 1, 3))
+        config->DlssNrPasses = (uint32_t) passes;
+    HelpMarker("More passes add cost. One pass remains the conservative default.");
+
+    ImGui::TextDisabled("F10 toggle  |  F11 preset  |  F12 close");
+    ImGui::PopItemWidth();
+}
