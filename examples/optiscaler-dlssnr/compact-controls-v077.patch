+void MenuCommon::RenderCompactDlssNrWindow(RenderMenuContext& ctx)
+{
+    if (!_isCompactDlssNrVisible)
+        return;
+
+    auto config = ctx.config;
+    const float menuResScale = ctx.menuResScale;
+
+    if (config->UseHQFont.value_or_default())
+        ImGui::PushFontSize(std::round(menuResScale * fontSize));
+
+    ImGuiWindowFlags flags = ImGuiWindowFlags_NoSavedSettings | ImGuiWindowFlags_NoCollapse |
+                             ImGuiWindowFlags_AlwaysAutoResize;
+    bool open = true;
+
+    if (ImGui::Begin("DLSS 5 - Neural Rendering", &open, flags))
+    {
+        DlssNr::RenderCompactMenu(config, menuResScale);
+        ImGui::Separator();
+
+        if (ImGui::Button("Save Settings"))
+            config->SaveIni();
+        ImGui::SameLine();
+        if (ImGui::Button("Close"))
+            open = false;
+    }
+    ImGui::End();
+
+    if (config->UseHQFont.value_or_default())
+        ImGui::PopFontSize();
+
+    if (!open)
+    {
+        _isCompactDlssNrVisible = false;
+        auto& io = ctx.io;
+        io.MouseDrawCursor = _isVisible;
+        io.WantCaptureKeyboard = _isVisible;
+        io.WantCaptureMouse = _isVisible;
+    }
+}
