    "output_assigned_does_not_mean_game_action_assigned": true,
    "eligible_accessible_empty_requires_opportunity_review": true,
    "fill_every_button_is_not_a_goal": true,
    "unknown_frequency_is_not_zero": true,
    "action_priority_policy": "A20-UF-1",
    "priority_formula": "P = 4 * (U - 1) + F",
    "priority_highest": 20,
    "primary_route_separate_from_incidental_aliases": true,
    "displaced_actions_must_be_reviewed": true
