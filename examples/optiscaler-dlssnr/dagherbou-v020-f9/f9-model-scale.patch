diff --git a/OptiScaler/dlssnr/DlssNr_ScaleCycle.h b/OptiScaler/dlssnr/DlssNr_ScaleCycle.h
new file mode 100644
index 0000000..4682fcf
--- /dev/null
+++ b/OptiScaler/dlssnr/DlssNr_ScaleCycle.h
@@ -0,0 +1,15 @@
+#pragma once
+
+namespace DlssNr
+{
+// Select the next smaller model scale, wrapping after 50%. Tolerance prevents
+// float roundoff from selecting the same step twice after a manual slider edit.
+constexpr float NextWorkingScale(float current)
+{
+    constexpr float steps[] = { 1.0f, 0.75f, 0.67f, 0.50f };
+    for (float step : steps)
+        if (current > step + 0.005f)
+            return step;
+    return 1.0f;
+}
+}
