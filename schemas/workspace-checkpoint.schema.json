{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Managed workspace operational checkpoint packages",
  "description": "V1 seeds remain byte/identity compatible. V2 adds bounded single-parent full/delta representations and inert extensions. Runtime additionally verifies identities, exact ancestry, closure, local grants and effect plans; schema conformance grants no authority.",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "schema_version",
        "kind",
        "format",
        "checkpoint",
        "package_id"
      ],
      "properties": {
        "schema_version": {
          "type": "integer",
          "const": 1
        },
        "kind": {
          "const": "GameToolsSeedPackage"
        },
        "format": {
          "const": "directory-objects-v1"
        },
        "checkpoint": {
          "type": "object",
          "required": [
            "checkpoint_id",
            "core"
          ],
          "properties": {
            "checkpoint_id": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "core": {
              "type": "object",
              "required": [
                "schema_version",
                "kind",
                "workspace_id",
                "project_id",
                "replica_id",
                "parents",
                "tombstones",
                "coverage",
                "files"
              ],
              "properties": {
                "schema_version": {
                  "type": "integer",
                  "const": 1
                },
                "kind": {
                  "const": "GameToolsSeedCheckpoint"
                },
                "workspace_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,191}$"
                },
                "project_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,191}$"
                },
                "replica_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,191}$"
                },
                "parents": {
                  "type": "array",
                  "maxItems": 0
                },
                "tombstones": {
                  "type": "array",
                  "maxItems": 0
                },
                "coverage": {
                  "const": {
                    "mode": "explicit_selected_files",
                    "unselected_files": "not_captured",
                    "unsaved_work": "not_observed",
                    "consistency": "saved_file_observation_only",
                    "excluded_classes": [
                      "action_approvals",
                      "browser_profiles",
                      "credentials",
                      "live_runtime_databases",
                      "local_permissions",
                      "os_credential_store",
                      "schedules"
                    ]
                  }
                },
                "files": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 512,
                  "items": {
                    "type": "object",
                    "required": [
                      "content_class",
                      "relative",
                      "bytes",
                      "sha256"
                    ],
                    "properties": {
                      "content_class": {
                        "enum": [
                          "project_source",
                          "selected_assets",
                          "selected_results",
                          "continuation_packet"
                        ]
                      },
                      "relative": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 240
                      },
                      "bytes": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 16777216
                      },
                      "sha256": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$"
                      }
                    },
                    "additionalProperties": false
                  }
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "package_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "schema_version",
        "kind",
        "format",
        "checkpoint",
        "package_id",
        "representation",
        "required_parents",
        "required_objects",
        "required_features",
        "extensions"
      ],
      "properties": {
        "schema_version": {
          "type": "integer",
          "const": 2
        },
        "kind": {
          "const": "GameToolsCheckpointPackage"
        },
        "format": {
          "const": "directory-objects-v2"
        },
        "checkpoint": {
          "type": "object",
          "required": [
            "checkpoint_id",
            "core"
          ],
          "properties": {
            "checkpoint_id": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "core": {
              "type": "object",
              "required": [
                "schema_version",
                "kind",
                "workspace_id",
                "project_id",
                "replica_id",
                "parents",
                "tombstones",
                "coverage",
                "files"
              ],
              "properties": {
                "schema_version": {
                  "type": "integer",
                  "const": 2
                },
                "kind": {
                  "const": "GameToolsCheckpoint"
                },
                "workspace_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,191}$"
                },
                "project_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,191}$"
                },
                "replica_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,191}$"
                },
                "parents": {
                  "type": "array",
                  "maxItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                },
                "tombstones": {
                  "type": "array",
                  "maxItems": 0
                },
                "coverage": {
                  "const": {
                    "mode": "explicit_selected_files",
                    "unselected_files": "not_captured",
                    "unsaved_work": "not_observed",
                    "consistency": "saved_file_observation_only",
                    "excluded_classes": [
                      "action_approvals",
                      "browser_profiles",
                      "credentials",
                      "live_runtime_databases",
                      "local_permissions",
                      "os_credential_store",
                      "schedules"
                    ]
                  }
                },
                "files": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 512,
                  "items": {
                    "type": "object",
                    "required": [
                      "content_class",
                      "relative",
                      "bytes",
                      "sha256"
                    ],
                    "properties": {
                      "content_class": {
                        "enum": [
                          "project_source",
                          "selected_assets",
                          "selected_results",
                          "continuation_packet"
                        ]
                      },
                      "relative": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 240
                      },
                      "bytes": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 16777216
                      },
                      "sha256": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$"
                      }
                    },
                    "additionalProperties": false
                  }
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "package_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "representation": {
          "enum": [
            "full",
            "delta"
          ]
        },
        "required_parents": {
          "type": "array",
          "maxItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required_objects": {
          "type": "array",
          "maxItems": 512,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required_features": {
          "const": [
            "complete-selection",
            "parent-bound"
          ]
        },
        "extensions": {
          "type": "object"
        }
      },
      "additionalProperties": false
    }
  ]
}
