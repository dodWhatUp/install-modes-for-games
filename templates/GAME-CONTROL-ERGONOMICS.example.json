  "little_finger_rules": [
    {
      "button_id": 37,
      "physical_row": 1,
      "default_role": "intentionally_empty",
      "assignment_requires_explicit_user_request": true,
      "agent_may_propose_assignment": true,
      "reason": "Less comfortable; retain empty until the user asks for an assignment"
    },
    {
      "button_id": 1,
      "physical_row": 2,
      "default_role": "momentary_WEAPONS_layer",
      "reason": "Easiest little-finger press; reserve for frequent weapon and comparable selection"
    },
    {
      "button_id": 2,
      "physical_row": 3,
      "default_role": "infrequent_action_candidate",
      "reason": "Least comfortable little-finger press; avoid frequent or urgent actions"
    },
    {
      "button_id": 3,
      "physical_row": 4,
      "default_role": "momentary_MENUS_layer",
      "reason": "Menus are less urgent than weapon selection"
    },
    {
      "button_id": 4,
      "physical_row": 5,
      "default_role": "optional_momentary_combat_or_overflow_layer",
      "layer_required": false,
      "reason": "Relatively comfortable hold for useful extra combat/ability or overflow actions when justified"
    }
  ],
  "unchanged_roles": [
    {"button_id": 36, "role": "TOOLS_layer", "location": "Side control left of the little-finger column"},
    {"button_id": 19, "role": "Overlay_hold", "game_output": "F24"},
    {"button_id": 24, "role": "movement_stick"}
  ],
  "held_layer_rule": {
    "other_controls_on_holder_finger": "unavailable_while_held",
    "may_remain_empty": true,
    "counts_as_missing_assignment": false,
    "holder_release_and_return_must_be_verified_separately": true
  },
  "action_planning": {
